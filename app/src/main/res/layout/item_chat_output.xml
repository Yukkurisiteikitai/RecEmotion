<?xml version="1.0" encoding="utf-8"?>
<!-- LLM 出力アイテム: 感情カラーバー + Markdown テキスト + コピーボタン -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- 感情カラーバー -->
    <View
        android:id="@+id/emotionBarOutput"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginBottom="6dp"
        android:background="#FFFFFF" />

    <!-- 出力エリア (Markdown テキスト + コピーボタン) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top">

        <!-- Markdown 出力テキスト (Markwon でレンダリング) -->
        <TextView
            android:id="@+id/txtChatOutput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#1AFFFFFF"
            android:fontFamily="sans-serif"
            android:lineSpacingMultiplier="1.4"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <!-- コピーボタン -->
        <ImageButton
            android:id="@+id/btnCopyOutput"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="コピー"
            android:src="@android:drawable/ic_menu_share"
            android:tint="#AAFFFFFF" />

    </LinearLayout>

</LinearLayout>
