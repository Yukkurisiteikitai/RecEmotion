<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:paddingTop="80dp">

        <!-- ヘッダー -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="0.2"
            android:text="SETUP"
            android:textColor="#FFFFFF"
            android:textSize="28sp" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF" />

        <!-- セクション①: カメラプレビュー (キャリブレーション中のみ表示) -->
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinderSetup"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:scaleType="fillCenter" />

        <!-- 顔感情分析セットアップボタン (タップ可能な行) -->
        <LinearLayout
            android:id="@+id/layoutCalibrationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:padding="8dp"
            android:background="?attr/selectableItemBackground">

            <!-- 状態アイコン or ProgressBar -->
            <FrameLayout
                android:layout_width="48dp"
                android:layout_height="48dp">

                <TextView
                    android:id="@+id/txtCalibrationIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✕"
                    android:textColor="#888888"
                    android:textSize="22sp" />

                <ProgressBar
                    android:id="@+id/progressCalibration"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="#FFFFFF"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- ラベル + エラーテキスト -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtCalibrationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="顔感情分析セットアップ"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/txtCalibrationError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="sans-serif-light"
                    android:textColor="#F44336"
                    android:textSize="12sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- セクション②: 自動起動設定 (キャリブレーション試行後に表示) -->
        <LinearLayout
            android:id="@+id/sectionAutoCalibrate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#33FFFFFF" />

            <CheckBox
                android:id="@+id/checkAutoCalibrate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:buttonTint="#FFFFFF"
                android:fontFamily="sans-serif-light"
                android:text="毎日自動でキャリブレーションを実行する"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <!-- 自動ON + 成功状態の場合のみ表示 -->
            <Button
                android:id="@+id/btnClearCalibration"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="キャリブレーションクリア"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                app:strokeColor="#555555" />
        </LinearLayout>

        <!-- セクション③: Wake Time Setup (キャリブレーション成功後に表示) -->
        <LinearLayout
            android:id="@+id/sectionWakeTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginBottom="16dp"
                android:background="#33FFFFFF" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.1"
                android:text="WAKE TIME"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="sans-serif-light"
                android:text="起床時刻をタップして変更できます"
                android:textColor="#66FFFFFF"
                android:textSize="11sp" />

            <!-- 時刻表示: タップで TimePickerDialog -->
            <TextView
                android:id="@+id/txtWakeTimeSetup"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-light"
                android:text="07:00"
                android:textColor="#FFFFFF"
                android:textSize="48sp"
                android:background="?attr/selectableItemBackground"
                android:padding="8dp" />

            <!-- 5秒カウントダウン -->
            <TextView
                android:id="@+id/txtWakeCountdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="sans-serif-light"
                android:text="5秒後に確定..."
                android:textColor="#88FFFFFF"
                android:textSize="12sp" />

            <!-- 確定ボタン -->
            <Button
                android:id="@+id/btnSetupConfirm"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="32dp"
                android:text="完了"
                android:textColor="#FFFFFF"
                app:strokeColor="#FFFFFF" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
